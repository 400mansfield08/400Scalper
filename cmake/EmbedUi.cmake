# Generates UiResources.h with the UI page and font as byte arrays.
# Usage: cmake -DOUT=... -DHTML=... -DFONT=... -P EmbedUi.cmake

function(embed_file path varname out_var)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR nbytes "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  # wrap lines every 32 bytes for readability / compiler friendliness
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
  set(${out_var} "inline const unsigned char ${varname}[${nbytes}] = {\n${bytes}\n};\n" PARENT_SCOPE)
endfunction()

embed_file("${HTML}" index_html html_block)
embed_file("${FONT}" font_ttf font_block)

file(WRITE "${OUT}.tmp" "// Generated by cmake/EmbedUi.cmake — do not edit.\n#pragma once\nnamespace scalper::ui {\n${html_block}\n${font_block}\n}\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
